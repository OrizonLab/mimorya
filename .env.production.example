# Configuration de l'installation de production (compose.production.yml, ADR-221)
# ===========================================================================
#
# Copiez ce fichier en .env.production, à côté de compose.production.yml, hors du
# dépôt, lisible par root seul (chmod 600) : il contient les secrets de
# l'installation. Puis :
#   docker compose --env-file .env.production -f compose.production.yml pull
#   docker compose --env-file .env.production -f compose.production.yml up -d
#
# Trois parties : les variables OBLIGATOIRES (sans elles, la pile ne démarre
# pas), les RECOMMANDÉES (sans elles, elle démarre mais il manque l'essentiel
# d'une vraie installation), les FACULTATIVES (leur défaut convient le plus
# souvent). Une valeur vide vaut une variable absente. Chaque variable lue par
# l'API est soit ici, soit fixée par compose.production.yml, soit tenue par
# l'image ; un test le vérifie (crates/api/tests/configuration_files.rs).
#
# Pour chaque variable : son rôle, sa valeur par défaut, comment la produire,
# ce qui se passe sans elle.


# ===========================================================================
# 1. OBLIGATOIRES
# ===========================================================================

# Nom de domaine sous lequel la plateforme est servie (sans https://).
# Défaut : aucun. Le DNS du domaine doit pointer vers ce serveur, ports 80 et 443
# ouverts. Sans lui : la pile refuse de démarrer.
MIMORYA_DOMAIN=

# Certificat TLS : une adresse e-mail pour un certificat public obtenu
# automatiquement (Let's Encrypt, par Caddy), ou « internal » pour l'autorité
# locale de Caddy (navigateurs avertis : réservé aux essais). Derrière un reverse
# proxy déjà installé, qui obtient lui-même le certificat : « internal », dont
# Caddy, qui ne démarre pas, ne se sert pas (docs/INSTALLATION.md, annexe).
# Défaut : aucun. Sans lui : la pile refuse de démarrer.
MIMORYA_TLS=

# Mot de passe du rôle propriétaire de la base (migrations, commandes
# d'exploitation). Lettres et chiffres seulement, 16 au moins : il entre dans des
# URL de connexion.
# Générer : openssl rand -hex 32
# Sans lui : la pile refuse de démarrer. La base garde celui de sa création :
# changer la variable seule coupe la connexion. Pour le changer, modifiez
# d'abord le rôle dans la base, puis la variable (README, « Pile
# conteneurisée de production »).
POSTGRES_PASSWORD=

# Mot de passe du rôle applicatif (mimorya_app), celui de l'API et des workers,
# soumis à la sécurité au niveau des lignes. Mêmes règles que le précédent,
# distinct de lui.
# Générer : openssl rand -hex 32
# Sans lui : la pile refuse de démarrer.
MIMORYA_APP_DB_PASSWORD=

# Clé maître : scelle (AES-256-GCM) les secrets des entreprises (leurs clés de
# modèle, les jetons des connecteurs, les comptes reliés, les seconds
# facteurs), et d'elle dérivent la clé des sceaux du journal d'audit et celle des
# limites de connexion. Base64 de 32 octets aléatoires.
# Générer : openssl rand -base64 32
# Gardez-en une copie hors du serveur (gestionnaire de secrets) : perdue, les
# secrets scellés sont illisibles et le journal d'audit ne se vérifie plus.
# Sans elle : la pile refuse de démarrer. Aucune entreprise ne pourrait garder
# sa propre clé de modèle (formule « clé du client »), ni relier un compte.
MIMORYA_MASTER_KEY=


# ===========================================================================
# 2. RECOMMANDÉES
# ===========================================================================

# Version des images publiées à installer : une version (1.2.0) ou un commit
# (sha-…). Lancez compose.production.yml depuis le même tag ou commit du dépôt :
# il monte des fichiers du dépôt.
# Défaut : latest, le dernier commit de main. Sans elle : une mise à jour des
# images change la plateforme au prochain pull, sans que vous l'ayez choisi.
MIMORYA_VERSION=

# --- Modèle de la plateforme (fourni par l'exploitant) ---------------------
# Clé d'API Anthropic de l'exploitant : le modèle des entreprises que vous
# fournissez (formules plafonnée ou prépayée, `mimorya-admin set-model-supply`,
# ADR-208), dont la vôtre. À créer dans la console d'Anthropic.
# Défaut : aucune. Sans elle : aucune entreprise n'a de modèle tant qu'elle n'a
# pas saisi sa propre clé dans « Administration > Modèle d'IA ».
ANTHROPIC_API_KEY=

# Modèle principal de la plateforme. Conseillé : claude-sonnet-5-5, rapide et
# économique ; claude-opus-5-5 en modèle d'escalade, pour les demandes difficiles
# ou les réponses qui échouent au contrôle : il se choisit par entreprise dans
# « Administration > Modèle d'IA > Escalade de modèle » (ADR-207, ADR-209).
# Défaut : claude-opus-5-5 pour Anthropic. Sans elle : chaque appel coûte le prix
# d'Opus.
LLM_MODEL=claude-sonnet-5-5

# --- E-mails ---------------------------------------------------------------
# Relais SMTP qui envoie les invitations, les liens de mot de passe oublié, les
# avis de validation, de fin de mission et les alertes de fourniture. Les
# identifiants seulement sur TLS :
#   smtps://utilisateur:motdepasse@smtp.example.com:465
#   smtp://utilisateur:motdepasse@smtp.example.com:587?tls=required (STARTTLS)
# Défaut : aucun, les deux ensemble ou aucun. Sans eux : l'administrateur
# transmet lui-même chaque lien d'invitation, aucun mot de passe oublié ne se
# réinitialise et aucun avis ne part par e-mail.
SMTP_URL=
# Expéditeur des e-mails, une adresse que le relais accepte d'envoyer, par
# exemple : Mimorya <no-reply@example.com>. Avec SMTP_URL, ou pas du tout :
# l'un sans l'autre, la pile refuse de démarrer.
MAIL_FROM=

# --- Sauvegardes -----------------------------------------------------------
# Clés publiques age des sauvegardes (age1…, séparées par des espaces) : chaque
# segment du journal de la base (WAL) est archivé, chiffré pour elles, ce qui
# permet la restauration à un instant précis (ADR-206, docs/RECOVERY_PLAN.md).
# Générer : age-keygen -o sauvegardes.key (gardez la clé privée HORS du
# serveur ; la clé publique est la ligne « public key: age1… »).
# Défaut : aucune. Sans elles : rien n'est archivé ; seules les sauvegardes
# lancées par infra/backup/backup.sh protègent la base.
MIMORYA_BACKUP_RECIPIENTS=


# ===========================================================================
# 3. FACULTATIVES (décommentez pour changer le défaut)
# ===========================================================================

# --- Installation ----------------------------------------------------------
# Nombre de workers qui exécutent les runs, côte à côte (ADR-087). Défaut : 1.
# MIMORYA_WORKERS=1
# Dossier de l'hôte où la base archive ses WAL chiffrés, à copier hors du
# serveur (docs/RECOVERY_PLAN.md). Défaut : ./wal-archive.
# MIMORYA_WAL_ARCHIVE=./wal-archive
# Journaux des processus : error, warn, info, debug, trace, off, ou un filtre
# (info,mimorya_api=debug). Défaut : info. La bibliothèque MCP (rmcp) reste
# muette sauf si on la nomme : ses journaux peuvent citer ce qu'un serveur a
# répondu, jeton d'une entreprise compris.
# LOG_LEVEL=info

# --- Marque (ADR-222) -------------------------------------------------------
# Rien de réglé, rien ne change : « Mimorya », les couleurs de l'interface,
# ni logo ni favicon. Un réglage refusé arrête l'API, qui dit pourquoi dans
# ses journaux (docker compose … logs api).
# Nom du produit : titre de l'onglet, connexion, barre latérale, e-mails,
# applications d'authentification. De 1 à 40 caractères, sans deux-points.
# Pensez à l'écrire aussi dans MAIL_FROM. Défaut : Mimorya.
# MIMORYA_PRODUCT_NAME=Mimorya
# Nom de l'assistant : conversations, consignes données au modèle, e-mails
# qui parlent de lui. Défaut : le nom du produit.
# MIMORYA_ASSISTANT_NAME=
# Couleur d'accent de l'interface (#rrggbb), en thème clair et en thème
# sombre, chacune facultative. Refusée si son contraste avec l'un des fonds de
# l'interface est sous 4,5:1 (WCAG AA). Défaut : celles de l'interface.
# MIMORYA_ACCENT_LIGHT=#1f5f8b
# MIMORYA_ACCENT_DARK=#5ea7d8
# Dossier de l'hôte qui contient le logo et le favicon, sous ces noms
# seulement : logo.svg, logo.png ou logo.webp (512 Kio au plus) ;
# favicon.svg, favicon.png ou favicon.ico (128 Kio au plus). Le type est lu
# du contenu ; un SVG qui contient un script, un gestionnaire d'événement ou
# une référence externe est refusé. Défaut : ./brand ; vide, aucune image.
# MIMORYA_BRAND_FOLDER=./brand

# --- Modèles ---------------------------------------------------------------
# Fournisseur du modèle de la plateforme : anthropic, openai, openrouter,
# gemini, ollama, openai_compatible ou none. Défaut : anthropic si
# ANTHROPIC_API_KEY est donnée, sinon aucun modèle de la plateforme.
# LLM_PROVIDER=anthropic
# Clé et adresse du fournisseur, quel qu'il soit : pour Anthropic, elles
# l'emportent sur ANTHROPIC_API_KEY et ANTHROPIC_BASE_URL.
# LLM_API_KEY=
# LLM_BASE_URL=
# Anthropic joint ailleurs qu'à son adresse officielle (une passerelle de
# l'exploitant). Défaut : https://api.anthropic.com.
# ANTHROPIC_BASE_URL=
# Un modèle relit chaque réponse au regard des critères de réussite de son run,
# quel qu'il soit. Défaut : false (la réponse d'une mission est relue de toute
# façon). Activé : un appel de plus par réponse d'un run qui a des critères.
# MIMORYA_LLM_JUDGE=false
# Serveurs de modèles privés qu'une entreprise peut choisir (ollama,
# openai_compatible), séparés par des virgules ; aucune autre adresse n'est
# jamais jointe. Défaut : aucun.
# MIMORYA_TENANT_LLM_ENDPOINTS=http://ollama.interne:11434/v1
# Mandataire HTTPS par lequel passent les fournisseurs de modèles, les modèles
# d'embeddings et Jev, et les hôtes joints sans lui. Jamais ce que les
# entreprises connectent (voir MIMORYA_OUTBOUND_PROXY). Défaut : aucun, accès
# direct.
# MIMORYA_MODEL_PROXY=http://mandataire.interne:3128
# MIMORYA_MODEL_NO_PROXY=ollama.interne
# Advisor d'Anthropic (en bêta) : un modèle d'escalade conseille le modèle
# principal pendant qu'il répond (ADR-207). Défaut : false.
# MIMORYA_ANTHROPIC_ADVISOR=false
# Jev de TypeSafe comme moteur du service de décision (ADR-213) : sous-traitant
# hors de l'Union européenne, à n'ouvrir qu'après la signature de son DPA et la
# demande de conservation nulle. Défaut : false ; version épinglée, délai en ms.
# MIMORYA_TYPESAFE_JEV=false
# MIMORYA_JEV_MODEL=jev-1.14.0
# MIMORYA_DECISION_TIMEOUT_MS=2000

# --- Connecteurs ------------------------------------------------------------
# Ce que les entreprises connectent (serveurs MCP, API REST…) joint aussi le
# réseau privé et le http:// en clair. Défaut : false (adresses publiques en
# HTTPS seulement). Exigé par MIMORYA_OUTBOUND_PROXY.
# MIMORYA_MCP_ALLOW_PRIVATE_NETWORK=false
# Mandataire par lequel passe ce que les entreprises connectent, et les hôtes
# joints sans lui (ADR-162). Défaut : aucun.
# MIMORYA_OUTBOUND_PROXY=http://mandataire.interne:3128
# MIMORYA_OUTBOUND_NO_PROXY=intranet.exemple,10.0.0.0/8
# Secondes qu'un serveur MCP peut prendre pour démarrer (1 à 120), et qu'un tour
# de conversation l'attend avant de partir sans lui (0 à 120). Défauts : 20 et 5.
# MIMORYA_MCP_START_TIMEOUT_SECS=20
# MIMORYA_MCP_START_PATIENCE_SECS=5

# --- Limites ---------------------------------------------------------------
# Mégaoctets de documents déposés que chaque entreprise peut garder (1 à
# 1048576). Défaut : 1024.
# MIMORYA_DOCUMENT_QUOTA_MB=1024
# Tentatives de connexion permises par adresse et par minute. Défaut : 10.
# LOGIN_RATE_LIMIT_PER_MINUTE=10
