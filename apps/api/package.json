{
  "name": "@mimorya/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP API: authentication, conversations, runs (SSE), approvals, memory and administration.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@mimorya/agent": "workspace:*",
    "@mimorya/connectors": "workspace:*",
    "@mimorya/core": "workspace:*",
    "@mimorya/db": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
