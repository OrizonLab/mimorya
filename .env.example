# --- PostgreSQL --------------------------------------------------------------
# Owner role: migrations and seed only.
DATABASE_URL=postgres://mimorya:mimorya@localhost:5432/mimorya
# Application role (mimorya_app): runtime connection, row-level security enforced.
DATABASE_APP_URL=postgres://mimorya_app:mimorya_app@localhost:5432/mimorya
# Integration tests (database name must end with _test; it is dropped and recreated).
TEST_DATABASE_URL=postgres://mimorya:mimorya@localhost:5432/mimorya_test
TEST_DATABASE_APP_URL=postgres://mimorya_app:mimorya_app@localhost:5432/mimorya_test

# --- API (Rust, crates/api) --------------------------------------------------
# development | test | production (production: secure cookies, DEMO_PASSWORD required)
MIMORYA_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# tracing filter: error | warn | info | debug | trace | off, or e.g. mimorya_api=debug
# The MCP library (rmcp) stays silent unless named (e.g. info,rmcp=warn): its
# logs may quote what a server sent back, a company's token included.
LOG_LEVEL=info
# true only behind a trusted reverse proxy that APPENDS the client address to
# X-Forwarded-For (the web relay alone forwards the client's header as is).
TRUST_PROXY=false
MIMORYA_ASSISTANT_NAME=Mimorya

# --- Model provider ----------------------------------------------------------
# anthropic | openai | openrouter | gemini | ollama | openai_compatible | none
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# For other providers:
# LLM_API_KEY=
# LLM_BASE_URL=
# Each company may also choose its own provider (Administration > Modèle d'IA).
# Master key sealing the companies' API keys: base64 of 32 random bytes
# (openssl rand -base64 32). Without it, no company key can be stored. Keep it
# out of the repository; losing it makes the stored keys unreadable.
MIMORYA_MASTER_KEY=
# Local or private model servers a company may choose (ollama,
# openai_compatible), comma-separated. Every listed endpoint is offered to every
# company. No other address is ever reached. The list is read at startup:
# removing an endpoint takes effect at the next restart.
# MIMORYA_TENANT_LLM_ENDPOINTS=http://ollama.internal:11434/v1
# MCP servers added by companies: public HTTPS addresses only. A private
# deployment may let them reach its own network (and plain http), and run
# stdio servers (child processes, configured by the operator only).
# MIMORYA_MCP_ALLOW_PRIVATE_NETWORK=false
# MIMORYA_MCP_ALLOW_STDIO=false
# Seconds an MCP server may take to connect and list its tools (1 to 120).
# MIMORYA_MCP_START_TIMEOUT_SECS=20

# --- E-mail ------------------------------------------------------------------
# Relay sending the invitation e-mails (ADR-027) and the password reset links
# (ADR-028). Without it, the administrator is shown each invitation link to
# transmit, and no reset link can be asked for. Credentials only over TLS:
# smtps://user:password@smtp.example.com:465 or
# smtp://user:password@smtp.example.com:587?tls=required (STARTTLS).
# For local tests, a catcher such as Mailpit: smtp://localhost:1025
# SMTP_URL=
# MAIL_FROM=Mimorya <no-reply@example.com>

# --- Demo --------------------------------------------------------------------
# Password of every fictional demo account created by `pnpm db:seed`; unset,
# the public development default `demo-mimorya`. Required in production (the
# demonstration stack, compose.demo.yml), where that default is refused.
# DEMO_PASSWORD=

# --- Web ---------------------------------------------------------------------
API_URL=http://localhost:4000
