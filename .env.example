# --- PostgreSQL --------------------------------------------------------------
# Owner role: migrations and seed only.
DATABASE_URL=postgres://mimorya:mimorya@localhost:5432/mimorya
# Application role (mimorya_app): runtime connection, row-level security enforced.
DATABASE_APP_URL=postgres://mimorya_app:mimorya_app@localhost:5432/mimorya
# Integration tests (database name must end with _test; it is dropped and recreated).
TEST_DATABASE_URL=postgres://mimorya:mimorya@localhost:5432/mimorya_test
TEST_DATABASE_APP_URL=postgres://mimorya_app:mimorya_app@localhost:5432/mimorya_test

# --- API (Rust, crates/api) --------------------------------------------------
# development | test | production (production: secure cookies, DEMO_PASSWORD required)
MIMORYA_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# tracing filter: error | warn | info | debug | trace | off, or e.g. mimorya_api=debug
LOG_LEVEL=info
# true only behind a trusted reverse proxy that APPENDS the client address to
# X-Forwarded-For (the web relay alone forwards the client's header as is).
TRUST_PROXY=false
MIMORYA_ASSISTANT_NAME=Mimorya

# --- Model provider ----------------------------------------------------------
# anthropic | openai | openrouter | gemini | ollama | openai_compatible | none
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# For other providers:
# LLM_API_KEY=
# LLM_BASE_URL=

# --- Demo --------------------------------------------------------------------
# Password of every fictional demo account created by `pnpm db:seed`.
DEMO_PASSWORD=demo-mimorya

# --- Web ---------------------------------------------------------------------
API_URL=http://localhost:4000
