# --- PostgreSQL --------------------------------------------------------------
# Owner role: migrations and seed only.
DATABASE_URL=postgres://mimorya:mimorya@localhost:5432/mimorya
# Application role (mimorya_app): runtime connection, row-level security enforced.
DATABASE_APP_URL=postgres://mimorya_app:mimorya_app@localhost:5432/mimorya
# Integration tests (database name must end with _test; it is dropped and recreated).
TEST_DATABASE_URL=postgres://mimorya:mimorya@localhost:5432/mimorya_test
TEST_DATABASE_APP_URL=postgres://mimorya_app:mimorya_app@localhost:5432/mimorya_test

# --- API (Rust, crates/api) --------------------------------------------------
# development | test | production (production: secure cookies, DEMO_PASSWORD required)
MIMORYA_ENV=development
# What this process does (ADR-085, ADR-086): all (serves the API and executes
# runs), api (serves the API; the runs it starts wait queued for a worker) or
# worker (executes runs, queued ones included, and the background work; serves
# nothing). Several processes of each role may run side by side; the Docker
# stacks run an api service and a worker service (ADR-087).
# Every role reads the same settings: an api process checks that a model can
# answer before queueing a run, a worker calls it.
MIMORYA_ROLE=all
# Address and port the API listens on (0.0.0.0:4000 by default).
HOST=0.0.0.0
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Session cookies only sent over HTTPS (Secure). True by default in
# production, false otherwise: a local http:// development keeps its session.
# SESSION_SECURE_COOKIE=false
# Login attempts allowed per client address and per minute (10 by default);
# the limits are shared by every api process (ADR-088).
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# tracing filter: error | warn | info | debug | trace | off, or e.g. mimorya_api=debug
# The MCP library (rmcp) stays silent unless named (e.g. info,rmcp=warn): its
# logs may quote what a server sent back, a company's token included.
LOG_LEVEL=info
# true only behind a trusted reverse proxy that APPENDS the client address to
# X-Forwarded-For (the web relay alone forwards the client's header as is).
TRUST_PROXY=false
# The assistant's name, as people read it and the model is told it.
MIMORYA_ASSISTANT_NAME=Mimorya

# --- Model provider ----------------------------------------------------------
# anthropic | openai | openrouter | gemini | ollama | openai_compatible | none
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Anthropic at another address than its official one (a gateway the operator
# runs); unset, https://api.anthropic.com. LLM_BASE_URL wins over it.
# ANTHROPIC_BASE_URL=
# For other providers:
# LLM_API_KEY=
# LLM_BASE_URL=
# A model reviews each answer against the success criteria its run was given,
# whatever the run: off by default, a mission's answer being reviewed anyway.
# On, a run given criteria costs a review call more per answer.
# MIMORYA_LLM_JUDGE=false
# Each company may also choose its own provider (Administration > Modèle d'IA).
# Master key sealing the companies' API keys: base64 of 32 random bytes
# (openssl rand -base64 32). Without it, no company key can be stored. Keep it
# out of the repository; losing it makes the stored keys unreadable. A key
# derived from it also keys the rate limit digests (ADR-152): changing or
# adding it restarts the windows still counting, once.
MIMORYA_MASTER_KEY=
# Local or private model servers a company may choose (ollama,
# openai_compatible), comma-separated, for its language model as for the
# embedding model that searches its memory by meaning (Administration).
# Every listed endpoint is offered to every company. No other address is ever
# reached. The list is read at startup: removing an endpoint takes effect at the
# next restart.
# MIMORYA_TENANT_LLM_ENDPOINTS=http://ollama.internal:11434/v1
# Anthropic's advisor (ADR-207): a company may let its main model consult its
# escalation model while it answers, on Anthropic at its official address. The
# function is in beta, and an agreement not to retain data does not cover every
# model: off unless the operator opens it.
# MIMORYA_ANTHROPIC_ADVISOR=false
# TypeSafe's Jev as an engine of decisions (ADR-213): quick, typed judgements a
# company may ask of Jev, on its own key, rather than of its main model.
# TypeSafe is a subprocessor outside the EU: off unless the operator opens it,
# once its DPA is signed and zero data retention requested. Its version is
# pinned (an alias such as jev-latest is refused); an engine that does not
# answer in time is given up for the main model.
# MIMORYA_TYPESAFE_JEV=false
# MIMORYA_JEV_MODEL=jev-1.14.0
# MIMORYA_DECISION_TIMEOUT_MS=2000
# MCP servers added by companies: public HTTPS addresses only. A private
# deployment may let them reach its own network (and plain http), and run
# stdio servers (child processes, configured by the operator only).
# MIMORYA_MCP_ALLOW_PRIVATE_NETWORK=false
# MIMORYA_MCP_ALLOW_STDIO=false
# The HTTP proxy what companies connect is reached through (MCP servers, REST
# APIs, Microsoft 365, Google, Slack, Telegram, Teams, identity providers),
# http(s)://[user:password@]host:port, and the hosts reached without it, as
# NO_PROXY writes them (ADR-162). The proxy resolves the names: it needs
# MIMORYA_MCP_ALLOW_PRIVATE_NETWORK=true, and should itself refuse what the
# platform may not reach. HTTPS goes through a tunnel (CONNECT) whose content
# the proxy does not read: a proxy intercepting TLS is not supported, and an
# https:// proxy carries a publicly trusted certificate. Its credentials are never
# written. The model providers, the embedding models and Jev follow the
# process's own HTTPS_PROXY and NO_PROXY instead, never this one;
# compose.production.yml passes them as MIMORYA_MODEL_PROXY and
# MIMORYA_MODEL_NO_PROXY.
# MIMORYA_OUTBOUND_PROXY=http://proxy.example:3128
# MIMORYA_OUTBOUND_NO_PROXY=intranet.example,10.0.0.0/8
# Seconds an MCP server may take to connect and list its tools (1 to 120).
# MIMORYA_MCP_START_TIMEOUT_SECS=20
# Seconds a person's turn waits for a connector starting before it goes without
# it, the start going on in the background for the next runs (0 to 120,
# ADR-177); the runs no one awaits wait for the start to end, and so does a
# turn when this is no shorter than the start timeout.
# MIMORYA_MCP_START_PATIENCE_SECS=5

# --- Documents -----------------------------------------------------------------
# The program reading deposited documents (ADR-095): mimorya-extract beside
# mimorya-api by default.
# MIMORYA_EXTRACTOR=/usr/local/bin/mimorya-extract
# Megabytes of documents each company may keep (1 to 1048576).
# MIMORYA_DOCUMENT_QUOTA_MB=1024

# --- E-mail ------------------------------------------------------------------
# Relay sending the invitation e-mails (ADR-027), the password reset links
# (ADR-028) and the notices of requests awaiting a manager (ADR-060). Without
# it, the administrator is shown each invitation link to transmit, no reset
# link can be asked for, and managers find their requests in the application.
# Credentials only over TLS:
# smtps://user:password@smtp.example.com:465 or
# smtp://user:password@smtp.example.com:587?tls=required (STARTTLS).
# For local tests, a catcher such as Mailpit: smtp://localhost:1025
# SMTP_URL=
# MAIL_FROM=Mimorya <no-reply@example.com>

# --- Demo --------------------------------------------------------------------
# Password of every fictional demo account created by `pnpm db:seed`; unset,
# the public development default `demo-mimorya`. Required in production (the
# demonstration stack, compose.demo.yml), where that default is refused.
# DEMO_PASSWORD=

# --- Web ---------------------------------------------------------------------
API_URL=http://localhost:4000
