{
  "name": "mimorya",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "cargo run --bin mimorya-api",
    "dev:web": "pnpm --filter @mimorya/web dev",
    "db:seed": "cargo run --bin mimorya-seed",
    "db:migrate": "cargo run --bin mimorya-admin -- migrate",
    "build": "cargo build --release --bin mimorya-api --bin mimorya-admin --bin mimorya-seed && pnpm --filter @mimorya/web build",
    "check": "pnpm check:rust && pnpm check:web",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace",
    "check:web": "pnpm --filter @mimorya/web typecheck && pnpm lint && pnpm format:check",
    "test:int": "cargo test-int",
    "test:e2e": "pnpm --filter @mimorya/web build && pnpm --filter @mimorya/web e2e",
    "lint": "eslint .",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
