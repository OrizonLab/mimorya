# Reverse proxy of the containerised stacks (ADR-032, ADR-034): TLS, HSTS
# (ADR-030), and one origin for the browser. /api/* goes straight to the
# API, which then reads the client's address as the last X-Forwarded-For
# entry (TRUST_PROXY=true); the rest goes to the web application.
#
# MIMORYA_DOMAIN defaults to localhost. MIMORYA_TLS is `internal` (Caddy's
# own local certificate authority, the default) or an e-mail address: Caddy
# then obtains a public certificate for the domain (ports 80 and 443
# reachable from the Internet).
{$MIMORYA_DOMAIN:localhost} {
	tls {$MIMORYA_TLS:internal}

	header Strict-Transport-Security "max-age=63072000; includeSubDomains"

	handle_path /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
